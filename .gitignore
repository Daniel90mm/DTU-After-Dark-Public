# AGENTS.md
# CLAUDE.md
# PRIVATE_changes.md
# .claude/
# config.local.js
# data/
# dist/
# infra/
# memory/
# node_modules/
# *.env
# *.log
# chrome-unpacked-temp/
# dtu_recon_output/
# secrets.json
# temp_library_styles_v3.css
# worker-deps-*.json
# scripts/instrument-function-hits.mjs
# scripts/make-chrome-webstore-screenshots.ps1
