    {
      "matches": ["*://learn.inside.dtu.dk/*"],
      "js": ["darkmode.textbooks.core.js", "darkmode.textbooks.kurser.js", "darkmode.textbooks.js", "darkmode.learn-nav.js", "darkmode.learn-shell.js", "darkmode.settings.bridge.js", "darkmode.settings.pause.js", "darkmode.settings.footer.js", "darkmode.settings.js", "darkmode.bus.presets.js", "darkmode.bus.setup.addline.js", "darkmode.bus.setup.js", "darkmode.bus.api.js", "darkmode.skeleton.js", "darkmode.bus.js", "darkmode.library-data.js", "darkmode.library-trend.js", "darkmode.content-shortcut.js", "darkmode.participant-intel-host.js", "darkmode.participant-intel-core.js", "darkmode.library.js", "darkmode.ics.js", "darkmode.deadlines.data.js", "darkmode.deadlines.timeline.js", "darkmode.deadlines.js"],
