{
  "manifest_version": 2,
  "name": "DTU After Dark",
  "version": "9.2.0",
  "description": "Dark mode, live bus departures, and GPA tools for DTU Learn, CampusNet, and other DTU sites.",
  "browser_specific_settings": {
    "gecko": {
      "id": "dtu-dark-mode@dtu-after-dark",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "images/icon_48.png",
    "128": "images/icon_128.png"
  },
  "optional_permissions": ["https://beyondborders.dtu.dk/*"],
  "permissions": [
    "storage",
    "https://api.mazemap.com/*",
    "https://www.rejseplanen.dk/*",
    "https://karakterer.dtu.dk/*",
    "https://findit.dtu.dk/*",
    "https://evaluering.dtu.dk/*",
    "https://student.dtu.dk/*",
    "https://kurser.dtu.dk/*",
    "https://eksamensplan.dtu.dk/*",
    "https://sts.ait.dtu.dk/*",
    "https://www.dtu.dk/*",
    "https://www.bibliotek.dtu.dk/*"
  ],
  "background": {
    "scripts": [
      "background.cache.js",
      "background.shared.js",
      "background.grades.js",
      "background.findit.js",
      "background.deadlines.js",
      "background.exam.js",
      "background.evaluation.js",
      "background.mazemap.js",
      "background.library.js",
      "background.js"
    ],
    "persistent": false
  },
  "web_accessible_resources": [
    "images/dtuaften.jpg",
    "images/logo_dark.png",
    "images/Corp_White_Transparent.svg",
    "images/mojangles_text.png",
    "images/mojangles_text_darkmode_off.png",
    "darkmode.css",
    "course-map-data.json",
  "exam-stats-data.json",
    "literature-data.json"
  ],
  "content_scripts": [
    {
      "matches": ["*://learn.inside.dtu.dk/*"],
      "js": ["darkmode.shadow-hook.page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://learn.inside.dtu.dk/*"],
      "js": ["config.js", "darkmode.dom.js", "darkmode.url-pause.js", "darkmode.feature-flags.js", "darkmode.accent-theme.js", "darkmode.participant-intel-bridge.js", "darkmode.storage.js", "darkmode.theme-state.js", "darkmode.js", "darkmode.dark-engine.page-cases.js", "darkmode.dark-engine.styles.js", "darkmode.dark-engine.js", "darkmode.learn-accent-shell.js", "darkmode.smart-room-linker.js"],
